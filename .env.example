# ─────────────────────────────────────────────────────────────────────────────
# Jobzz — variables d'environnement.
# Copie ce fichier en `.env` à la racine : `cp .env.example .env`
# `.env` est ignoré par Git. Ne mets JAMAIS de secret réel ici.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=Jobzz
NODE_ENV=development
APP_URL=http://localhost:4200
API_URL=http://localhost:3000
API_PORT=3000

# Base de données (correspond à docker-compose.yml)
DATABASE_URL=postgresql://jobzz:jobzz@localhost:5432/jobzz?schema=public

# Secrets de session (change-les en production — utilise des valeurs longues et aléatoires)
JWT_SECRET=dev-jwt-secret-change-me-please-make-it-long
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-please-make-it-long

# Compte administrateur (créé au démarrage s'il n'existe pas)
ADMIN_EMAIL=admin@jobzz.local
ADMIN_PASSWORD=admin-change-me-10

# Mail (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Jobzz <bonjour@jobzz.local>

# Sources d'offres : `demo` (offres fictives) ou `live`
JOB_SOURCES_MODE=demo
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
LBA_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Intelligence artificielle (Ollama) — jamais indispensable
AI_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Offres Gratuit / Premium
# false (défaut local) : tout le monde est Premium, aucune limite, pages Tarifs/Abonnement masquées
# true : les limites du gratuit s'appliquent (mode pour tester le paiement)
PLAN_ENFORCEMENT=false

# Stripe (CLÉS DE TEST UNIQUEMENT en local : sk_test_… / pk_test_…)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_PASS_3_MONTHS=

# Bêta sur invitation (facultatif : vide = inscription libre)
BETA_INVITE_CODE=
